---
import { getLocalizedCollection } from '../i18n/mergeContent';
import { useTranslations } from '../i18n';
import { siteConfig } from '../config/site';
import ExperienceJobCard from './ExperienceJobCard.astro';
import ExperienceDescriptionPanel from './ExperienceDescriptionPanel.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const localized = await getLocalizedCollection('experience', locale);
const sorted = localized.sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());
const capped = sorted.slice(0, siteConfig.experience.homepageCount);
const hasMore = sorted.length > capped.length;
---

<section id="experience-section" class="section-experience section section--border-bottom">
  <div class="row flex-column-reverse flex-md-row" data-experience-widget>
    <div class="experience-list col-12 col-md-6">
      <h2 class="section__title mb-4">{t('experience_title')}</h2>

      {capped.map(({ entry, isFallback }, index) => (
        <ExperienceJobCard entry={entry} isFallback={isFallback} locale={locale} selected={index === 0} />
      ))}

      {hasMore && (
        <div class="all-experience-container">
          <a href={`/${locale}/experience/`} class="btn btn-primary btn-all-experience">
            {t('experience_button3')}
          </a>
        </div>
      )}
    </div>
    <div class="experience-description col-12 col-md-6">
      {capped.map(({ entry }, index) => (
        <ExperienceDescriptionPanel entry={entry} selected={index === 0} />
      ))}
    </div>
  </div>
</section>
