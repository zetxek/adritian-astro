---
import LanguageSelector from './LanguageSelector.astro';
import ThemeSelector from './ThemeSelector.astro';
import { useTranslations } from '../i18n';
import { siteConfig } from '../config/site';

interface Props {
  locale: string;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);
const notice = siteConfig.footerNotice[locale] ?? siteConfig.footerNotice.en;
---

<footer class="footer w-100 d-print-none">
  <div class="container items">
    <div class="container">
      <div class="row w-100 align-items-center">
        <div class="footer_left col-12 col-lg-4 mb-3 mb-lg-0 text-center text-lg-start">
          <div class="footer__copy">
            <span set:html={notice} />
          </div>
        </div>
        <nav class="footer_links col-12 col-lg-6 mb-3 mb-lg-0 text-center text-lg-start" aria-label={t('footer_navigation')}>
          <ul class="navbar-nav w-100 align-items-center justify-content-center justify-content-lg-start d-flex flex-wrap gap-2">
            {(siteConfig.headerMenu[locale] ?? siteConfig.headerMenu.en).map((item) => (
              <li class="nav-item">
                <a class="nav-link" href={item.url}>{item.name.toUpperCase()}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="footer_right col-12 col-lg-2 mb-3 mb-lg-0 text-center text-lg-end">
          <div class="d-flex flex-column flex-lg-row justify-content-center align-items-center gap-2 d-grid col-12">
            <LanguageSelector locale={locale} currentPath={currentPath} placement="footer" />
            <ThemeSelector locale={locale} placement="footer" />
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
