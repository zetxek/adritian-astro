---
import { useTranslations } from '../i18n';

interface Props {
  locale: string;
  placement: 'header' | 'footer';
}

const { locale, placement } = Astro.props;
const t = useTranslations(locale);
const direction = placement === 'footer' ? 'dropup' : '';
---

<div id={`${placement}-color-selector`} class={`d-grid gap-2 col-6 mx-auto nav-link dropdown ${direction}`}>
  <button
    class="btn btn-link py-2 px-0 px-lg-2 dropdown-toggle d-flex align-items-center bd-theme-selector"
    id={`bd-theme-${placement}`}
    type="button"
    aria-expanded="false"
    aria-controls={`theme-dropdown-${placement}`}
    aria-haspopup="true"
    data-bs-toggle="dropdown"
    data-bs-display="static"
    aria-label={t('toggle_theme')}
  >
    <svg class="theme-icon me-1" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-theme-icon="light">
      <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.414a.5.5 0 1 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707L4.464 3.757a.5.5 0 0 1 0 .708z" />
    </svg>
    <svg class="theme-icon me-1 d-none" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-theme-icon="dark">
      <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z" />
    </svg>
    <svg class="theme-icon me-1 d-none" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-theme-icon="auto">
      <path d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16Z" />
      <path d="M8 1a7 7 0 0 1 0 14V1Z" />
    </svg>
    <span class="current-theme">{t('theme_auto')}</span>
    <span class="d-lg-none ms-2 visually-hidden bd-theme-text" id={`bd-theme-text-${placement}`}>{t('toggle_theme')}</span>
  </button>
  <ul id={`theme-dropdown-${placement}`} class={`dropdown-menu dropdown-menu-end ${direction}`} aria-labelledby={`bd-theme-text-${placement}`} data-bs-popper="static">
    <li>
      <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light" aria-pressed="false">
        {t('theme_light')}
      </button>
    </li>
    <li>
      <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark" aria-pressed="false">
        {t('theme_dark')}
      </button>
    </li>
    <li>
      <button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="auto" aria-pressed="true">
        {t('theme_auto')}
      </button>
    </li>
  </ul>
</div>
