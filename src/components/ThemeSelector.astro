---
import { useTranslations } from '../i18n';

interface Props {
  locale: string;
  placement: 'header' | 'footer';
}

const { locale, placement } = Astro.props;
const t = useTranslations(locale);
const direction = placement === 'footer' ? 'dropup' : '';
---

<div id={`${placement}-color-selector`} class={`d-grid gap-2 col-6 mx-auto nav-link dropdown ${direction}`}>
  <button
    class="btn btn-link py-2 px-0 px-lg-2 dropdown-toggle d-flex align-items-center show bd-theme-selector"
    id={`bd-theme-${placement}`}
    type="button"
    aria-expanded="false"
    aria-controls={`theme-dropdown-${placement}`}
    aria-haspopup="true"
    data-bs-toggle="dropdown"
    data-bs-display="static"
    aria-label={t('toggle_theme')}
  >
    <span class="current-theme">{t('theme_auto')}</span>
    <span class="d-lg-none ms-2 visually-hidden bd-theme-text" id={`bd-theme-text-${placement}`}>{t('toggle_theme')}</span>
  </button>
  <ul id={`theme-dropdown-${placement}`} class={`dropdown-menu dropdown-menu-end ${direction}`} aria-labelledby={`bd-theme-text-${placement}`} data-bs-popper="static">
    <li>
      <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light" aria-pressed="false">
        {t('theme_light')}
      </button>
    </li>
    <li>
      <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark" aria-pressed="false">
        {t('theme_dark')}
      </button>
    </li>
    <li>
      <button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="auto" aria-pressed="true">
        {t('theme_auto')}
      </button>
    </li>
  </ul>
</div>
