---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n';
import { siteConfig } from '../config/site';
import { slugOf, type BlogEntry } from '../lib/blog';

interface Props {
  locale: string;
  recentPosts: BlogEntry[];
  tags: { tag: string; count: number }[];
}

const { locale, recentPosts, tags } = Astro.props;
const t = useTranslations(locale);
const recent = recentPosts.slice(0, siteConfig.blog.recentPostCount);
// Hugo's blog-sidebar.html iterates .Site.Taxonomies.tags, which Go templates
// range over in key (alphabetical) order — not by usage count.
const sortedTags = [...tags].sort((a, b) => a.tag.localeCompare(b.tag));
---

<aside class="blog-sidebar col-sidebar">
  {
    siteConfig.blog.showCategories && sortedTags.length > 0 && (
      <div class="sidebar-section categories">
        <h3>{t('categories')}</h3>
        <ul class="tags">
          {sortedTags.map(({ tag }) => (
            <li>
              <a href={`/${locale}/blog/tags/${tag}/`}>{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  {
    siteConfig.blog.showRecentPosts && recent.length > 0 && (
      <div class="sidebar-section recent-posts">
        <h3>{t('recent_posts')}</h3>
        <ul>
          {recent.map(({ entry }: { entry: CollectionEntry<'blog'> }) => (
            <li>
              <a href={`/${locale}/blog/${slugOf(entry)}/`}>{entry.data.title}</a>
              <span class="post-date">{entry.data.date.toLocaleDateString(locale)}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</aside>
