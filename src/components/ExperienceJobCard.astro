---
import { Picture } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n';

interface Props {
  entry: CollectionEntry<'experience'>;
  isFallback: boolean;
  locale: string;
  /** Marks the job pre-selected on load (matches Hugo's `.experience.selected`
   * on the current job's single page) — first item in the list by default. */
  selected: boolean;
}

const { entry, isFallback, locale, selected } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
---

<details class={`experience${selected ? ' selected' : ''}`} data-experience-item open={selected} data-locale={isFallback ? 'en (fallback)' : locale}>
  <summary class="experience__link">
    <div class="experience__header">
      {entry.data.companyLogo && (
        <Picture
          src={entry.data.companyLogo}
          alt={`${entry.data.company} logo`}
          class="experience__company-logo"
          width={48}
          height={48}
          densities={[1, 2]}
          formats={['webp']}
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="experience__meta">
        <div class="experience__date">{entry.data.duration}</div>
        <div class="experience__title">{entry.data.jobTitle}</div>
        <div class="experience__company">
          {entry.data.company}. <span class="experience__location">{entry.data.location}</span>
        </div>
        {isFallback && <div class="experience__fallback-badge">{t('experience_fallback_notice')}</div>}
      </div>
    </div>
  </summary>
  <div class="experience__description-inline">
    <h1>{entry.data.title}</h1>
    <Content />
  </div>
</details>
