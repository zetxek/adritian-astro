---
/**
 * Visual breadcrumb bar — ports layouts/partials/breadcrumb.html. The
 * BreadcrumbList JSON-LD counterpart (seo/breadcrumbs-jsonld.html) is built
 * separately in Layout.astro from the same `items` list, since Astro has no
 * equivalent of Hugo's Page.Ancestors to derive it from automatically.
 */
export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const current = items[items.length - 1];
const ancestors = items.slice(0, -1);
---

<section id="breadcrumb-bar" class="breadcrumb-bar container">
  <nav aria-label="breadcrumb" class="d-print-none">
    <ol class="breadcrumbs">
      {ancestors.map((item) => (
        <li class="breadcrumb-item">
          <a href={item.url} class="breadcrumb-link">
            {item === ancestors[0] && <span class="breadcrumb-icon" aria-hidden="true">🏠</span>}
            <span class="breadcrumb-text">{item.name}</span>
          </a>
        </li>
      ))}
      <li class="breadcrumb-item active" aria-current="page">
        <span class="breadcrumb-text">{current.name}</span>
      </li>
    </ol>
  </nav>
</section>
