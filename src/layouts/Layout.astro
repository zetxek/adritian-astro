---
import bootstrapCssUrl from 'bootstrap/dist/css/bootstrap.min.css?url';
import bootstrapRtlCssUrl from 'bootstrap/dist/css/bootstrap.rtl.min.css?url';
import '../styles/global.css';
import '../styles/breadcrumbs.css';
import '../styles/rtl.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { useTranslations, locales, defaultLocale, switchLocalePath, isRtl } from '../i18n';
import { siteConfig } from '../config/site';
import { buildSiteJsonLd, buildBreadcrumbJsonLd, absoluteUrl, type BreadcrumbItem } from '../lib/seo';

interface Props {
  locale: string;
  title?: string;
  description?: string;
  image?: string;
  /** Ancestors + current page (Home is added automatically), e.g.
   * [{ name: 'Blog', url: '/en/blog/' }, { name: 'Getting started', url: '/en/blog/getting-started/' }] */
  breadcrumbs?: BreadcrumbItem[];
  /** Extra page-specific JSON-LD objects (e.g. BlogPosting) appended after the
   * site-wide WebSite/Person schema this layout always emits. */
  jsonLd?: Record<string, unknown>[];
}

const { locale, title, description, image, breadcrumbs, jsonLd = [] } = Astro.props;
const t = useTranslations(locale);
const dir = isRtl(locale) ? 'rtl' : 'ltr';

// Bootstrap ships a separate pre-built RTL stylesheet (mirrored selectors,
// not just a couple of overrides) rather than a runtime dir switch, so the
// two builds are loaded as alternatives, never both — matches Hugo's own
// theme, which has no RTL support at all (this is new for the Astro port).
// Resolved via `?url` + an explicit <link> (not a side-effect `import
// '...css'`) because Astro's static CSS bundling links every module reached
// by either branch of a conditional import on every page — a side-effect
// import here would ship (and, worse, order-depending-on-branch, silently
// let one override the other) both stylesheets on every locale.
const bootstrapHref = dir === 'rtl' ? bootstrapRtlCssUrl : bootstrapCssUrl;

const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const pageDescription = description ?? t('head_description');
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, siteConfig.baseURL);
const ogImage = absoluteUrl(image ?? siteConfig.seo.siteImage);

// hreflang alternates: every locale-prefixed route resolves for every locale
// (content falls back to the default locale — see mergeContent.ts), so the
// alternate for each locale is a straight locale-segment swap of the current
// path. x-default points at the default-locale (en) version, matching common
// multilingual SEO practice (Hugo's own head.html doesn't emit x-default —
// this is an intentional improvement, see NOTE.md).
const alternateLinks = locales.map((altLocale) => ({
  hreflang: altLocale,
  href: new URL(switchLocalePath(currentPath, altLocale), siteConfig.baseURL).toString(),
}));
const xDefaultHref = new URL(switchLocalePath(currentPath, defaultLocale), siteConfig.baseURL).toString();

const homeBreadcrumb: BreadcrumbItem = { name: t('home'), url: `/${locale}/` };
const breadcrumbItems = breadcrumbs ? [homeBreadcrumb, ...breadcrumbs] : null;

const allJsonLd = [
  ...buildSiteJsonLd(locale, pageDescription),
  ...(breadcrumbItems ? [buildBreadcrumbJsonLd(breadcrumbItems.map((b) => ({ name: b.name, url: absoluteUrl(b.url) })))] : []),
  ...jsonLd,
];
---

<!DOCTYPE html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="stylesheet" href={bootstrapHref} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />

    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <link rel="alternate" type="application/rss+xml" href={`/${locale}/rss.xml`} title={`${siteConfig.title} (${locale})`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {allJsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <!-- Anti-flash of unstyled theme: set data-bs-theme before first paint, mirrors head.html's inline snippet -->
    <script is:inline>
      (function () {
        var storedTheme = localStorage.getItem('theme');
        var isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme && storedTheme !== 'auto') {
          document.documentElement.setAttribute('data-bs-theme', storedTheme);
        } else {
          document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme-auto', 'true');
        }
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} currentPath={currentPath} />

    {breadcrumbItems && <Breadcrumbs items={breadcrumbItems} />}

    <main id="main-content" class="container" tabindex="-1">
      <slot />
    </main>

    <div class="d-print-none">
      <Footer locale={locale} currentPath={currentPath} />
    </div>

    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
      import '../scripts/color-modes.js';
    </script>
  </body>
</html>
