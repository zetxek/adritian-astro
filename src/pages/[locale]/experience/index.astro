---
import Layout from '../../../layouts/Layout.astro';
import ExperienceList from '../../../components/ExperienceList.astro';
import '../../../styles/experience.css';
import { useTranslations, locales } from '../../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = useTranslations(locale);
---

<Layout
  locale={locale}
  title={t('experience_title')}
  description={t('experience_description')}
  breadcrumbs={[{ name: t('experience_title'), url: `/${locale}/experience/` }]}
>
  <ExperienceList locale={locale} />
</Layout>
