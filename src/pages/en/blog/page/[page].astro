---
import Layout from '../../../../layouts/Layout.astro';
import BlogListPage from '../../../../components/BlogListPage.astro';
import { useTranslations } from '../../../../i18n';
import { siteConfig } from '../../../../config/site';
import { getSortedBlogPosts, getTagCounts, paginate } from '../../../../lib/blog';
import '../../../../styles/blog-list.css';
import '../../../../styles/blog-sidebar.css';
import '../../../../styles/pagination.css';

const locale = 'en';

export async function getStaticPaths() {
  const posts = await getSortedBlogPosts('en');
  const lastPage = Math.max(1, Math.ceil(posts.length / siteConfig.blog.pagerSize));
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const t = useTranslations(locale);
const posts = await getSortedBlogPosts(locale);
const currentPage = Number(Astro.params.page);
const page = paginate(posts, { pageSize: siteConfig.blog.pagerSize, currentPage, baseUrl: `/${locale}/blog/` });
const tags = getTagCounts(posts);
---

<Layout
  locale={locale}
  title={t('blog_title')}
  description={t('blog_description')}
  breadcrumbs={[{ name: t('blog_title'), url: `/${locale}/blog/` }]}
>
  <BlogListPage locale={locale} page={page} recentPosts={posts} tags={tags} />
</Layout>
